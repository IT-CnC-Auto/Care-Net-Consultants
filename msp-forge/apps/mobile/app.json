{
  "expo": {
    "name": "Bee-Inspect",
    "slug": "care-net-consultants",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beeinspect",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.carenetconsultants.carenetconsultants",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DC2626",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.carenetconsultants.carenetconsultants",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#DC2626"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DC2626",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#DC2626",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Bee-Inspect uses Face ID to unlock your saved sign in.",
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Bee-Inspect records the voice notes you make during an inspection.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Bee-Inspect uses the camera to photograph findings and to scan equipment tags and claim codes.",
          "microphonePermission": "Bee-Inspect records the voice notes you make during an inspection.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bee-Inspect lets you add a photo or a certificate from your gallery.",
          "cameraPermission": "Bee-Inspect uses the camera to photograph findings and certificates.",
          "microphonePermission": "Bee-Inspect records the voice notes you make during an inspection."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bee-Inspect seals the location into your inspection photos and voice notes, when you have given location consent.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Bee-Inspect uses Face ID so you can unlock the app after your authenticator sign in."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "c292cf70-a15c-4b64-8925-fbd1c238d2d4"
      }
    },
    "owner": "care-net-consultants",
    "description": "Bee-Inspect: the Care Net health and safety inspection and risk assessment app for competent persons."
  }
}
