# Bee-Inspect phone app: public build settings, inlined into the app by Expo.
# Copy to .env.local for local runs, or set them as EAS environment variables
# (preview and production) for builds. Never commit real values.
# Only the Supabase project URL and its publishable (anon) key belong here; they
# are public by design. Never put a service role key or any secret in the app.
# Leave these as they are to run the demo only.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
